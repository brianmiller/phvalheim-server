#!/bin/bash
echo
echo "`date` [NOTICE : phvalheim] Starting PhValheim pre-flight..."
echo "`date` [NOTICE : phvalheim] PhValheim Version: $phvalheimVersion"


# load configs
source /opt/stateless/engine/includes/phvalheim-static.conf
source /opt/stateless/engine/includes/0-functions.sh

# set initial timezone from env var (DB not ready yet)
/opt/stateless/engine/tools/tzSetter.sh

# wait for database
/opt/stateless/engine/includes/1-waitfordatabase.sh

# run database schema update processor
/opt/stateless/engine/tools/dbUpdater.sh

# prep directories and filesystem
/opt/stateless/engine/tools/phvalheimprep.sh

# reconcile backup records with files on disk
/opt/stateless/engine/tools/worldBackupReconcile

# sweep up mod selection rows whose world no longer exists. Runs after dbUpdater.sh so the
# table is guaranteed to exist, and before the main loop so a world created this boot cannot
# be handed a recycled id that still carries a deleted world's mods.
pruneOrphanedWorldMods

# Sync both mod catalogues, every boot -- a restarted server should come back with a current
# mod list rather than waiting up to the cron interval. Builds from scratch if this server has
# none yet (fresh install, or a volume restored from before 2.43); otherwise change detection
# makes it a ~2s no-op. Replaces the old GitHub seed download.
syncModCatalogue

# migrate environment variables to database (one-time, for upgrades from pre-2.31)
setupComplete=$(SQL "SELECT setupComplete FROM settings")
if [ "$setupComplete" = "0" ]; then
	# Check if any env vars are set (indicates upgrade from older version)
	envVarFound=0
	for envVar in steamAPIKey gameDNS basePort phvalheimClientURL backupsToKeep sessionTimeout openaiApiKey geminiApiKey claudeApiKey ollamaUrl; do
		val="${!envVar}"
		if [ ! -z "$val" ]; then
			envVarFound=1
			break
		fi
	done

	if [ $envVarFound = 1 ]; then
		echo "`date` [NOTICE : phvalheim] Migrating environment variables to database settings..."

		# Migrate each env var if it has a value
		[ ! -z "$steamAPIKey" ]       && SQL "UPDATE settings SET steamApiKey='$steamAPIKey'"
		[ ! -z "$gameDNS" ]           && SQL "UPDATE settings SET gameDNS='$gameDNS'"
		[ ! -z "$basePort" ]          && SQL "UPDATE settings SET basePort='$basePort'"
		[ ! -z "$phvalheimClientURL" ] && SQL "UPDATE settings SET phvalheimClientURL='$phvalheimClientURL'"
		[ ! -z "$backupsToKeep" ]     && SQL "UPDATE settings SET backupsToKeep='$backupsToKeep'"
		[ ! -z "$sessionTimeout" ]    && SQL "UPDATE settings SET sessionTimeout='$sessionTimeout'"
		[ ! -z "$openaiApiKey" ]      && SQL "UPDATE settings SET openaiApiKey='$openaiApiKey'"
		[ ! -z "$geminiApiKey" ]      && SQL "UPDATE settings SET geminiApiKey='$geminiApiKey'"
		[ ! -z "$claudeApiKey" ]      && SQL "UPDATE settings SET claudeApiKey='$claudeApiKey'"
		[ ! -z "$ollamaUrl" ]         && SQL "UPDATE settings SET ollamaUrl='$ollamaUrl'"
		[ ! -z "$TZ" ]                && SQL "UPDATE settings SET timezone='$TZ'"

		# Mark as migrated (setupComplete=1 triggers one-time migration notice in admin UI)
		SQL "UPDATE settings SET setupComplete=1, migrationNoticeShown=0"
		echo "`date` [NOTICE : phvalheim] Environment variables migrated to database. These env vars are now deprecated and can be removed from your Docker configuration."
	else
		# Check if worlds exist — if so, this is an upgrade (not a fresh install)
		worldCount=$(SQL "SELECT COUNT(*) FROM worlds")
		if [ "$worldCount" -gt 0 ] 2>/dev/null; then
			echo "`date` [NOTICE : phvalheim] Existing worlds detected but no environment variables found. Showing migration notice so admin can configure settings."
			SQL "UPDATE settings SET setupComplete=1, migrationNoticeShown=0"
		else
			echo "`date` [NOTICE : phvalheim] Fresh install detected. Setup wizard will be available at the admin UI (port 8081)."
		fi
	fi
fi

# pull settings from database (DB is now the source of truth)
export basePort=$(SQL "SELECT basePort FROM settings")
export defaultSeed=$(SQL "SELECT defaultSeed FROM settings")
export gameDNS=$(SQL "SELECT gameDNS FROM settings")
export steamAPIKey=$(SQL "SELECT steamApiKey FROM settings")
export phvalheimClientURL=$(SQL "SELECT phvalheimClientURL FROM settings")
export backupsToKeep=$(SQL "SELECT backupsToKeep FROM settings")
export maxLogSize=$(SQL "SELECT maxLogSize FROM settings")
export sessionTimeout=$(SQL "SELECT sessionTimeout FROM settings")
export TZ=$(SQL "SELECT timezone FROM settings")

# apply timezone from database to the running system
if [ -f "/usr/share/zoneinfo/$TZ" ]; then
	echo "$TZ" > /etc/timezone
	ln -sf /usr/share/zoneinfo/$TZ /etc/localtime
else
	echo "`date` [WARN : phvalheim] Invalid timezone '$TZ' in database, falling back to UTC"
	export TZ="Etc/UTC"
	echo "$TZ" > /etc/timezone
	ln -sf /usr/share/zoneinfo/$TZ /etc/localtime
fi

# sync MariaDB global timezone with system timezone
TZ_OFFSET=$(date +%:z)
SQL "SET GLOBAL time_zone = '$TZ_OFFSET'"

# set environment
#Filtered to VALID SHELL IDENTIFIERS. /etc/environment is sourced by the main loop below
#(every 2 seconds) and by bash.bashrc, so any line bash cannot parse as an assignment is
#run as a command instead. Unraid templates name port variables after the range they map
#-- UDP_PORT_25000-25100=25000-25100 -- and a hyphen is not legal in an identifier, so
#every tick logged "UDP_PORT_25000-25100=25000-25100: command not found". That is ~30
#lines a minute forever, in the log operators send us when something is actually wrong.
#Nothing needed those variables; they were only ever collateral from dumping printenv.
/usr/bin/printenv | grep -E '^[A-Za-z_][A-Za-z0-9_]*=' | grep -v "^HOME=" | grep -v "^PWD=" > /etc/environment
cat /etc/bash.bashrc|grep "source /etc/environment" > /dev/null 2>&1
if [ ! $? = 0 ]; then
        echo "source /etc/environment" >> /etc/bash.bashrc
fi

# generate analytics UUID on first run
analyticsUUID=$(SQL "SELECT analyticsUUID FROM settings")
if [ -z "$analyticsUUID" ]; then
	analyticsUUID=$(cat /proc/sys/kernel/random/uuid)
	SQL "UPDATE settings SET analyticsUUID='$analyticsUUID'"
	echo "`date` [NOTICE : phvalheim] Analytics UUID generated: $analyticsUUID"
fi
export analyticsUUID
export analyticsEnabled=$(SQL "SELECT analyticsEnabled FROM settings")

# push analytics on startup (background, non-blocking)
if [ "$analyticsEnabled" = "1" ]; then
	echo "`date` [NOTICE : phvalheim] Pushing analytics data..."
	/opt/stateless/engine/tools/pushAnalytics.sh >> /opt/stateful/logs/phvalheim.log 2>&1 &
fi

# post pre-flight echos
echo "`date` [NOTICE : phvalheim] basePort: $basePort"
echo "`date` [NOTICE : phvalheim] defaultSeed: $defaultSeed"
echo "`date` [NOTICE : phvalheim] gameDNS: $gameDNS"
echo "`date` [NOTICE : phvalheim] backupsToKeep: $backupsToKeep"
echo "`date` [NOTICE : phvalheim] maxLogSize: $maxLogSize"
echo "`date` [NOTICE : phvalheim] timezone: $TZ"

# start the engine
echo "`date` [NOTICE : phvalheim] PhValheim engine started..."

# autostart routine
autoStart

####### BEGIN: Main loop #######
while [ true ]; do
	sleep 2

	# Re-read environment so admin UI setting changes (timezone, etc.) take effect
	source /etc/environment

	# gameDNS is re-read from the database on EVERY pass, not just at engine start.
	#
	# This MUST come after the source above, not before: /etc/environment is written once
	# at boot from printenv, so sourcing it re-imposes the boot-time gameDNS and would
	# quietly undo the refresh.
	#
	# The engine is a long-running process -- weeks between restarts -- so the value
	# exported at startup is whatever Game DNS was when the container last booted. Reading
	# that variable looks live and is not: it is why 2.49's first attempt at this fix
	# still wrote the OLD hostname into a world's quick_connect_servers.cfg even though
	# the operator had changed the setting and then updated the world.
	#
	# Exported because importWorld.sh and the other spawned scripts read it as well.
	export gameDNS=$(SQL "SELECT gameDNS FROM settings")

	WORLDS=$(SQL "SELECT id FROM worlds;")

	for WORLD in $WORLDS; do
		worldID=$WORLD
		worldMode=$(SQL "SELECT mode FROM worlds WHERE id='$worldID';")
		worldName=$(SQL "SELECT name FROM worlds WHERE id='$worldID';")
		worldPort=$(SQL "SELECT port FROM worlds WHERE id='$worldID';")
		worldSeed=$(SQL "SELECT seed FROM worlds WHERE id='$worldID';")
		#QuickConnect's host comes from the LIVE gameDNS setting, not from the copy that
		#was stamped into worlds.external_endpoint when the world was created. That column
		#was write-once -- there was no UPDATE for it anywhere in the tree -- so changing
		#Game DNS in Server Settings moved the Steam launch string (which reads gameDNS
		#live) and left quick_connect_servers.cfg pointing at the old name forever. The two
		#join paths disagreed, which is why this looked unfixable for years.
		#
		#The column is kept as the value the admin UI displays, and is refreshed from this
		#one in the update path below, so the setting, the cfg and the display cannot drift
		#apart again.
		worldHost="$gameDNS"
		if [ -z "$worldHost" ]; then
			#gameDNS not set yet (setup wizard unfinished). Fall back to the stored
			#value rather than writing an empty host into the cfg -- an empty host is
			#exactly what an imported world used to get, and it silently breaks the
			#QuickConnect entry instead of merely pointing it somewhere stale.
			worldHost=$(SQL "SELECT external_endpoint FROM worlds WHERE id='$worldID';")
		fi
		worldVanilla=$(SQL "SELECT IFNULL(vanilla,0) FROM worlds WHERE id='$worldID';")
		worldPassword="hammertime";

		# A vanilla world's seed is invented by Valheim when it first generates the
		# .fwl, so it is unknown until then. Read it back out of the save once it
		# exists. No-op once recorded, and for modded worlds that already have a seed.
		syncWorldSeedFromSave "$worldName" "$worldVanilla"


		if [ "$worldMode" = "stopped" ]; then
			# A process here is only ORPHANED if supervisor does not own it. If it does,
			# SIGKILL is unwinnable: the world program is autorestart=true, so supervisor
			# logs "terminated by SIGKILL; not expected" and respawns it, and the next
			# 2s tick kills the new PID. That loop has no exit -- a user's log showed it
			# running for minutes, one kill per tick, the PID climbing every time.
			#
			# So ask supervisor first, which marks the stop EXPECTED and suppresses the
			# restart, and only SIGKILL what is left over afterwards.
			if worldProcessRunning "$worldName"; then
				supervisorState=$(/usr/bin/supervisorctl status valheimworld_$worldName 2>/dev/null|tr -s " "|cut -d " " -f2)
				case "$supervisorState" in
					RUNNING|STARTING|BACKOFF)
						echo "`date` [WARN: phvalheim] World '$worldName' is marked stopped but supervisor still has it $supervisorState. Stopping it through supervisor..."
						/usr/bin/supervisorctl stop valheimworld_$worldName > /dev/null 2>&1
						;;
				esac

				orphanedPIDs=$(ps -ef|grep phvalhe+|grep "/opt/stateful/games/valheim/worlds/$worldName/game/valheim_server.x86_64"|grep -v "sh -c"|grep -v grep|tr -s " " |cut -d " " -f2)
				for orphanedPID in $orphanedPIDs; do
					echo "`date` [WARN: phvalheim] Murdering orphaned PID: $orphanedPID"
					kill -9 $orphanedPID
				done
			fi
		fi


		# NEVER invent a seed for a vanilla world. A seed only reaches Valheim through
		# the CustomSeed BepInEx mod, which a vanilla world does not run, and Valheim
		# has no seed argument -- so anything generated here could never be that
		# world's actual seed, and storing it puts a fabricated number on the public
		# card. A vanilla world's seed comes from its .fwl, via syncWorldSeedFromSave,
		# and only after it has started.
		if [ "$worldVanilla" != "1" ]; then
			if [ -z "$worldSeed" ]; then
				worldSeed="$defaultSeed"
			fi
			if [ -z "$worldSeed" ]; then
				worldSeed=$(od -An -tu4 -N4 /dev/urandom | tr -d ' ')
				echo "`date` [NOTICE : phvalheim] Generated random seed for '$worldName': $worldSeed"
				SQL "UPDATE worlds SET seed='$worldSeed' WHERE id='$worldID'"
			fi
		fi


		if [ "$worldMode" = "create" ]; then
			echo "`date` [NOTICE : phvalheim] New world '$worldName' detected, creating..."
			SQL "UPDATE worlds SET mode='creating' WHERE name='$worldName'"

			# Assign port if not already assigned (may be NULL if directory was pre-created by clone)
			worldPort=$(SQL "SELECT port FROM worlds WHERE name='$worldName'")
			if [ -z "$worldPort" ] || [ "$worldPort" = "NULL" ]; then
				echo "`date` [NOTICE : phvalheim] Assigning port for '$worldName'..."
				worldPort=$(getNextPort)
				SQL "UPDATE worlds SET port='$worldPort' WHERE name='$worldName'"
			fi

			# Create directory structure if it doesn't exist
			if [ ! -d "$worldsDirectoryRoot/$worldName" ]; then
				echo "`date` [NOTICE : phvalheim] Worlds directory for '$worldName' is missing, creating..."
				worldDirPrep "$worldName"
			else
				echo "`date` [NOTICE : phvalheim] Worlds directory for '$worldName' already exists (from clone), ensuring structure..."
				worldDirPrep "$worldName"
			fi

			echo "`date` [NOTICE : phvalheim] Deploying new world '$worldName'..."
			# Judge the deployment on its POSTCONDITION -- the directory tree
			# worldDirPrep is contracted to produce -- not on the exit status of a
			# chown.
			#
			# This used to be `chown -R phvalheim: ...; RESULT=$?`, and the else branch
			# below deleted the worlds row and rm -rf-ed the directory. chown answers
			# "could I change ownership of every file I walked", which is not the same
			# question: ONE unchownable file (NFS root_squash, an immutable bit, a file
			# vanishing mid-walk) destroyed a world whose deployment had gone fine. The
			# identical bad oracle is documented in InstallAndUpdateValheim, where it
			# only mislabelled a good update.
			#
			# The chown itself was also redundant -- worldDirPrep ends with exactly this
			# command, on this path, immediately above. It existed only to set RESULT.
			deployMissing=$(worldDirIsPrepared "$worldName")
			if [ $? = 0 ]; then
				echo "`date` [NOTICE : phvalheim] World '$worldName' successfully created..."

				echo "`date` [NOTICE : phvalheim] Checking for required mods..."

				#generate custom seed config
				#
				#Custom seeds are implemented by the ZeroBandwidth-CustomSeed BepInEx
				#mod, so a vanilla world cannot use one -- Valheim itself has no seed
				#argument, the seed is baked into the .fwl at first generation.
				if [ "$(SQL "SELECT IFNULL(vanilla,0) FROM worlds WHERE name='$worldName'")" = "1" ]; then
					echo "`date` [NOTICE : phvalheim] World '$worldName' is vanilla -- custom seed not applied (requires a mod). Valheim will generate a random seed."
				else
					createCustomSeedConfig "$worldName" "$worldSeed"
				fi

				#create supervisor config file for this world
				createSupervisorWorldConfig "$worldName" "$worldPassword" "$worldPort"

                                #set create and updated timestamp for new deployment
                                SQL "UPDATE worlds SET date_deployed='`date +'%F %T'`' WHERE name='$worldName'"

				#set new world to update state
				SQL "UPDATE worlds SET mode='update' WHERE name='$worldName'"

			else
				# Mark it broken and LEAVE IT ALONE. This used to delete the worlds row
				# and rm -rf the directory, which was wrong twice over:
				#
				# 1. A deleted row is indistinguishable from a world that never existed.
				#    The operator clicked Create and watched it vanish, with the only
				#    explanation in the engine log. 'broken' is the state this engine
				#    already uses for exactly this -- see the three sites below -- and
				#    none of those delete anything either.
				# 2. This branch also handles a CLONE, whose directory arrives already
				#    populated with a copied save. rm -rf took that with it.
				#
				# An operator who wants the failed world gone can delete it from the UI,
				# which runs the real delete path -- the one that also kills orphaned
				# PIDs and removes the supervisor config. Keeping a second, partial
				# implementation of "remove a world" here only invited the two to drift.
				echo "`date` [FAIL : phvalheim] ERROR: World '$worldName' failed deployment -- missing:$deployMissing"
				echo "`date` [FAIL : phvalheim] Marking '$worldName' broken. Nothing was deleted; delete it from the admin UI if you want it gone."
				SQL "UPDATE worlds SET mode='broken' WHERE name='$worldName'"
			fi
		fi

		if [ "$worldMode" = "delete" ]; then
			echo "`date` [WARN : phvalheim] Delete command received for world '$worldName':"
			worldNameLength=$(echo "$worldName"|wc -c)
			if [ $worldNameLength -gt 1 ]; then
				echo "`date` [WARN : phvalheim] Deleting world '$worldName'..."
	                        orphanedPIDs=$(ps -ef|grep phvalhe+|grep "/opt/stateful/games/valheim/worlds/$worldName/game/valheim_server.x86_64"|grep -v "sh -c"|grep -v grep|tr -s " " |cut -d " " -f2)
	                        for orphanedPID in $orphanedPIDs; do
	                                echo "`date` [WARN : phvalheim] Murdering orphaned PID: $orphanedPID"
	                                kill -9 $orphanedPID
	                        done
				rm -rf $worldsDirectoryRoot/$worldName
			        
				#delete supervisor config file for this world
                                deleteSupervisorWorldConfig "$worldName"

				#world_mods is keyed on worlds.id, so it MUST be cleared before the
				#worlds row goes -- afterwards there is nothing left to resolve the id
				#from and the rows are unreachable garbage.
				#
				#Not merely untidy: InnoDB recomputes AUTO_INCREMENT as MAX(id)+1 on
				#restart, so after deleting the highest-numbered world the next world
				#created can be handed the same id and would inherit the deleted
				#world's entire mod selection.
				deleteWorldModRows "$worldName"

				SQL "DELETE FROM worlds WHERE name='$worldName'"
			fi
		fi

                if [ "$worldMode" = "stop" ]; then
			echo "`date` [NOTICE : phvalheim] Stop command received for world '$worldName':"
			/usr/bin/supervisorctl status valheimworld_$worldName > /dev/null 2>&1
                        worldPID_status=$?
			if [ $? = 0 ]; then
				SQL "UPDATE worlds SET mode='stopping' WHERE name='$worldName'"
				echo "`date` [NOTICE : phvalheim] Stopping world '$worldName'..."
				/usr/bin/supervisorctl stop valheimworld_$worldName > /dev/null 2>&1
			else
				echo "`date` [WARN : phvalheim] World '$worldName' doesn't appear to be running..."
				SQL "UPDATE worlds SET mode='stopped' WHERE name='$worldName'"
			fi

			#Give it time to stop (we're sending a graceful shutdown, SIGINT)
			killLoop=0
			while [ $killLoop -le 5 ]; do
				sleep 10 
				let killLoop=killLoop+1
				worldProcessRunning "$worldName"
	                        if [ ! $? = 0 ]; then
	                                echo "`date` [NOTICE : phvalheim] World '$worldName' successfully stopped."
					SQL "UPDATE worlds SET mode='stopped' WHERE name='$worldName'"
					break
				else
					echo "`date` [WARN : phvalheim] World '$worldName' did not stop in the allowed time of 10 seconds. The world may still stop soon. You should probably check this..."
	                        fi
			done
		
		fi

		if [ "$worldMode" = "start" ]; then
			echo "`date` [NOTICE : phvalheim] Start command recieved for world '$worldName':"

			/usr/bin/supervisorctl status valheimworld_$worldName > /dev/null 2>&1
			worldPID_status=$?
			if [ $worldPID_status = 0 ]; then
				echo "`date` [WARN : phvalheim] World '$worldName' is already running..."
				SQL "UPDATE worlds SET mode='running' WHERE name='$worldName'"
			else
				SQL "UPDATE worlds SET mode='starting' WHERE name='$worldName'"
				/usr/bin/supervisorctl start valheimworld_$worldName > /dev/null 2>&1
				if [ $? != 0 ]; then
					# One world that will not start must NOT take the engine down with it.
					# supervisor restarts the engine, and the engine's pre-flight resets every
					# world to 'stopped' -- so one unstartable world became a restart loop that
					# also clobbered any create/update queued against the OTHER worlds.
					echo "`date` [ERROR : phvalheim] ERROR: Could not start world '$worldName'. Marking it broken and continuing; the reason is in /opt/stateful/logs/valheimworld_$worldName.log"
					SQL "UPDATE worlds SET mode='broken' WHERE name='$worldName'"
				else
					# Bounded wait. This loop had no limit, so a world that started and then
					# died -- a rejected password, a mod that aborts -- parked the engine here
					# forever and no other world's commands were ever processed again.
					startWait=0
					/usr/bin/supervisorctl status valheimworld_$worldName > /dev/null 2>&1
					worldPID_status=$?
					while [ $worldPID_status != 0 ] && [ $startWait -lt 60 ]; do
						echo "`date` [NOTICE : phvalheim] Waiting for world '$worldName' to start..."
						sleep 2
						let startWait=startWait+1
						/usr/bin/supervisorctl status valheimworld_$worldName > /dev/null 2>&1
						worldPID_status=$?
					done

					/usr/bin/supervisorctl status valheimworld_$worldName > /dev/null 2>&1
					worldPID_status=$?
					if [ $worldPID_status = 0 ]; then
						echo "`date` [NOTICE : phvalheim] World '$worldName' has started!"
						SQL "UPDATE worlds SET mode='running' WHERE name='$worldName'"
					else
						echo "`date` [ERROR : phvalheim] World '$worldName' did not come up within 120s. Marking it broken and continuing; see /opt/stateful/logs/valheimworld_$worldName.log"
						SQL "UPDATE worlds SET mode='broken' WHERE name='$worldName'"
					fi
				fi
			fi
		fi

		if [ "$worldMode" = "update" ]; then
			echo "`date` [NOTICE : phvalheim] Update command recieved for world '$worldName':"
			# Ask the process table. This guard used to read worlds.pid, a column
			# NOTHING writes, so it always saw an empty pid, always concluded "not
			# running", and let steamcmd rewrite a live world under its own players.
			# Nothing that sets mode='update' stops the world first -- not the mod-list
			# save, not the Rebuild Mods button, not Hugin (all go through updateWorld()
			# in db_sets.php). So refusing here is not a safe default: the mode is never
			# cleared, the loop revisits it every 2 seconds, and the log fills with the
			# same refusal forever while the update never happens. Observed on a real
			# server the moment the guard below started working.
			#
			# Stop it ourselves instead, and remember that it WAS running so it can be
			# started again at the end. That is the distinction the update path cares
			# about: it ends on mode='stopped' deliberately so it cannot start a world
			# the operator had deliberately stopped -- but a world the operator had
			# RUNNING should come back.
			wasRunning=0
			if worldProcessRunning "$worldName"; then
				wasRunning=1
				echo "`date` [NOTICE : phvalheim] World '$worldName' is running. Stopping it for the update; it will be started again afterwards..."
				/usr/bin/supervisorctl stop valheimworld_$worldName > /dev/null 2>&1
				stopWait=0
				while worldProcessRunning "$worldName" && [ $stopWait -lt 180 ]; do
					sleep 5
					let stopWait=stopWait+5
				done
			fi

			if worldProcessRunning "$worldName"; then
				# Bail out LOUDLY and leave a mode the loop will not revisit, rather
				# than spinning on this world forever.
				echo "`date` [ERROR : phvalheim] World '$worldName' would not stop within 180s, so it cannot be updated safely. Marking it broken; stop it by hand and try again."
				SQL "UPDATE worlds SET mode='broken' WHERE name='$worldName'"
			else
				echo "`date` [NOTICE : phvalheim] Updating world '$worldName'..."
				SQL "UPDATE worlds SET mode='updating' WHERE name='$worldName'"

				#Update Valheim
				InstallAndUpdateValheim "$worldName"
				if [ $? -ne 0 ]; then
					echo "`date` [ERROR : phvalheim] Valheim installation failed for '$worldName', aborting update..."
					SQL "UPDATE worlds SET mode='stopped', status='failed' WHERE name='$worldName'"
					continue
				fi

				#Is this a vanilla (zero-mod) world? See docs/RELEASE-2.40-DESIGN.md
				isVanilla=$(SQL "SELECT IFNULL(vanilla,0) FROM worlds WHERE name='$worldName'")

				if [ "$isVanilla" = "1" ]; then
					#A vanilla world means ZERO MODS: no BepInEx, no system plugins,
					#no quickconnect, no Thunderstore mods. Players join it with
					#Valheim's own +connect, so there is no client payload either.
					echo "`date` [NOTICE : phvalheim] World '$worldName' is vanilla -- skipping BepInEx, mods and client packaging."

					#Make sure a world converted to vanilla has no mod remnants
					purgeWorldModsConfigsPatchers "$worldName"

					#The files are gone, so say so. A world converted to vanilla keeps its
					#world_mods rows, and without this they stay installed_at NULL -- which
					#means UNKNOWN, and the Updates tab waits for data that this path never
					#produces. They are not unknown: they are known NOT installed, which is
					#the middle state the two columns exist to carry.
					/opt/stateless/engine/tools/worldMods.py --world "$worldName" --record-installed "" \
						|| echo "`date` [WARN : phvalheim] Could not record the purged mod state for '$worldName'."

					#Empty the mod viewer list so the UI doesn't show stale mods
					generateModViewerJson "$worldName"
				else
					#Update BepInEx
					InstallAndUpdateBepInEx "$worldName"

					#Delete mods+configs, before downloading, installing and packaging. This is needed when a mod is removed.
					purgeWorldModsConfigsPatchers "$worldName"

					#add required mods to final list
					mergeRequiredTsMods "$worldName"

					#Install mods
					downloadAndInstallTsModsForWorld "$worldName"
					if [ $? -ne 0 ]; then
						#A modded world with no plugins must NOT be published. It used to be
						#packaged, given an md5, marked ready and started, and the only symptom
						#was BepInEx reporting "0 plugins to load" in the world log -- which
						#nobody sees until a player joins and finds a vanilla server.
						echo "`date` [ERROR : phvalheim] Mod installation failed for '$worldName' -- leaving it stopped, and NOT touching its client payload or md5."
						SQL "UPDATE worlds SET mode='stopped', status='failed' WHERE name='$worldName'"
						continue
					fi

					#generate mod viwer list
					generateModViewerJson "$worldName"

					#Refresh the stored endpoint so the admin UI shows the host the cfg
					#was actually written with. This is the step the Game DNS notice
					#points at: changing the setting alone rewrites nothing on disk --
					#a world has to be updated before its players see the new name.
					SQL "UPDATE worlds SET external_endpoint='$worldHost' WHERE id='$worldID';"

					#Generate quick connect config
					createQuickConnectConfig "$worldName" "$worldHost" "$worldPort" "$worldPassword"

					#Install system plugins (health monitor, etc)
					installSystemPlugins "$worldName"

					#Install custom mods and config
					installCustomModsConfigsPatchers "$worldName"

					#The loader's own config, AFTER every config-touching step above and
					#BEFORE the client is packaged. packageClient() zips ./BepInEx
					#wholesale, so this is the last moment that decides whether the world
					#log gets its plugin lines and the client gets its console window.
					ensureBepInExLoaderConfig "$worldName"

					#Packge client
					packageClient "$worldName"
				fi

				if [ "$isVanilla" != "1" ]; then
					#Copy custom_config_secure files to. These files will not end up on the client side
					InstallCustomConfigSecureFiles "$worldName"

					#Update the database to reflect new client pacakge version via MD5
					worldMD5=$(getMD5 "/opt/stateful/games/valheim/worlds/$worldName/$worldName.zip")
					#A modded world MUST have a client payload. An empty md5 here means
					#packageClient produced no zip -- do not let that pass as the same
					#quiet "cleared" state a vanilla world legitimately has.
					if [ -z "$worldMD5" ]; then
						echo "`date` [WARNING : phvalheim] No client payload found for modded world '$worldName' -- clients will have nothing to sync."
					fi
					setMD5 "$worldName" "$worldMD5"
				else
					#No client payload exists for a vanilla world, so there is nothing to
					#checksum. Clear it rather than leaving the md5 of a stale zip behind,
					#which the client would otherwise treat as a payload worth syncing.
					setMD5 "$worldName" ""
				fi

				#set last updated timestamp
				SQL "UPDATE worlds SET date_updated='`date +'%F %T'`' WHERE name='$worldName'"

				#finally, put the world back the way we found it. Stopped is the
				#default on purpose -- a hand-edited mod list must not start a world
				#the operator left stopped -- but one that WAS running is restarted.
				if [ "$wasRunning" = "1" ]; then
					echo "`date` [NOTICE : phvalheim] Update finished; starting '$worldName' again..."
					SQL "UPDATE worlds SET mode='start' WHERE name='$worldName'"
				else
					SQL "UPDATE worlds SET mode='stopped' WHERE name='$worldName'"
				fi

								

			fi
		fi



	done

done
####### END: Main loop #######
