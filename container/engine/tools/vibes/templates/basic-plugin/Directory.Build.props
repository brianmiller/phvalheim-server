<Project>
  <!-- GENERATED by Hugin's Vibes and committed on purpose: the paths are PROPERTIES, so this
       repository builds anywhere by overriding them -
         dotnet build -p:VibesLibs=/my/libs -p:VibesPak=/my/pak
       VibesLibs: the harvested Valheim assemblies (assembly_valheim_publicized.dll, UnityEngine.*).
       VibesPak:  the Build Pak; bepinex/ holds BepInEx.dll and 0Harmony.dll. -->
  <PropertyGroup>
    <VibesLibs Condition="'$(VibesLibs)' == ''">/opt/stateful/vibes/libs</VibesLibs>
    <VibesPak Condition="'$(VibesPak)' == ''">/opt/stateful/vibes/buildpak/current</VibesPak>
  </PropertyGroup>
</Project>
