#!/bin/bash
PHV_LOG_SOURCE=updateApplier   # names this tool in the event log (2.56)
source /opt/stateless/engine/includes/phvalheim-static.conf
# 0-functions.sh too, for InstallAndUpdateValheim(). Without it the game branch silently
# does nothing and the world is restarted on its old build while the UI reports success.
source /opt/stateless/engine/includes/0-functions.sh

# Apply pending game / mod updates to a world once it looks idle. Issue #87.
#
# This is the only thing in PhValheim that stops a server nobody asked it to stop, so it is
# deliberately reluctant: every gate has to say yes, and anything it cannot establish counts
# as a no. updateChecker decides WHAT is available; this decides only WHEN.
#
# Usage:
#   updateApplier                 scheduled sweep over every eligible world
#   updateApplier <world> now     apply immediately, skipping the idle and window gates
#                                 (the admin UI's "Update now" button -- an operator
#                                 pressing it has decided already)

lockFile="/tmp/.updateApplier.lock"
# Open the lock READ-ONLY. flock(2) honours LOCK_EX on a read-only descriptor, and a lock
# file's contents are never read -- so write permission was never needed, and demanding it
# is what wedged the mod-catalogue sync in 2.47-2.51. /tmp is sticky: whichever uid creates
# the file owns it, and the other can then neither truncate (`exec 9>`) nor remove it. Only
# phvalheim invokes this today (cron + the admin UI's "Update now"), so this is defensive --
# but if anything ever calls it as root, auto-updates would stop permanently and silently.
# Same idiom as modSync.py's open_lock(). (2.52)
[ -e "$lockFile" ] || (umask 0022; : > "$lockFile") 2>/dev/null
exec 9<"$lockFile"
flock -n 9 || exit 0

targetWorld="${1:-}"
forceNow="${2:-}"

# Effective setting: per-world override or global, exactly like worldBackup's. A world with
# autoupdate_use_global=1 takes the global value; anything else means its own columns win.
# A global "on for all worlds" does NOT reach into a world that has opted out through its
# own override block -- that is the semantics operators already know from backups.
getEffective() {
	local worldName="$1" worldCol="$2" globalCol="$3"

	local globalValue=$(SQL "SELECT IFNULL($globalCol,'') FROM settings LIMIT 1;")
	local useGlobal=$(SQL "SELECT autoupdate_use_global FROM worlds WHERE name='$worldName';")

	if [ "$useGlobal" = "1" ] || [ -z "$useGlobal" ]; then
		echo "$globalValue"
	else
		local worldValue=$(SQL "SELECT IFNULL($worldCol,'') FROM worlds WHERE name='$worldName';")
		if [ -n "$worldValue" ]; then echo "$worldValue"; else echo "$globalValue"; fi
	fi
}

# Is the world quiet enough to touch?
#
# A count of zero, recently observed, is idle. EVERYTHING ELSE IS NOT -- including a nonzero
# count whose observation has gone stale.
#
# That last clause used to read the other way, and it is what kicked a real operator's players
# off mid-session. 2.47 treated a nonzero count as idle once the observation aged past the
# threshold, reasoning that a count can stick in the log after everyone has left: verified on a
# production world that logged "now 1 player(s)" and then nothing for 39 minutes while empty.
# Without some such arm, one unclean teardown parks a world in "waiting" forever.
#
# The trouble is that a stale nonzero count has TWO causes and the count cannot tell them apart:
#
#   a) everyone left uncleanly and the leave was never logged   -> safe to update
#   b) a player joined and is STILL PLAYING                     -> updating kicks them
#
# (b) is not an edge case, it is the normal shape of a session. playerMonitor derives a
# crossplay world's count from "... now N player(s)", which PlayFab emits on join and on leave
# and at no other time -- so a player who joins and then plays for an hour produces exactly one
# line, an hour old, saying 1. idleMinutes defaults to 30. Half an hour into their session the
# observation is "stale", the world is declared idle, and the server is stopped underneath them.
# That is the Discord report: players kicked because PhValheim shut the world down for an
# update while they were on it.
#
# So the arm is gone. A nonzero count means NOT IDLE, which is this script's own stated rule --
# "anything it cannot establish counts as a no" -- applied to the one place that broke it.
#
# The cost is real and is the correct trade: a world whose count is stuck nonzero will not
# auto-update on the idle path. It is not stuck forever, because the operator already has an
# explicit escape hatch that does not require guessing on their behalf --
# autoupdate_max_wait_hours with autoupdate_on_timeout='force' updates regardless of players,
# and the sweep below checks that BEFORE it ever calls this function. Choosing to accept a
# disconnection after N hours is a decision an operator can make; having it made for them
# silently, 30 minutes into someone's session, is not.
#
# Accurate live player detection -- via the server-side Companion rather than log scraping --
# is the real fix and is on the backlog (docs/BACKLOG.md). Until it lands, auto-updates are
# marked Beta in the admin UI and remain OFF by default.
#
# A world with no observation at all (player_count_at IS NULL) is NOT idle. That is the
# unknown case, and unknown must never authorise a restart.
isIdle() {
	local worldName="$1" idleMinutes="$2"

	local count=$(SQL "SELECT IFNULL(player_count,0) FROM worlds WHERE name='$worldName';")
	local haveObs=$(SQL "SELECT COUNT(*) FROM worlds WHERE name='$worldName' AND player_count_at IS NOT NULL;")

	[ "$haveObs" = "1" ] || return 1

	# The ONLY idle verdict: a zero that was observed recently. A world whose log stopped
	# being written is not something we know anything current about, so an ancient zero is
	# unknown rather than empty.
	if [ "$count" = "0" ]; then
		local fresh=$(SQL "SELECT COUNT(*) FROM worlds WHERE name='$worldName' \
			AND player_count_at > DATE_SUB(NOW(), INTERVAL $((idleMinutes * 3)) MINUTE);")
		[ "$fresh" = "1" ] && return 0
		return 1
	fi

	return 1
}

# Is now inside the maintenance window? Start of -1 (or no length) means "any time".
inWindow() {
	local start="$1" hours="$2"

	# Each guard on its own line. Chaining these as `[ a ] || [ b ] && return 0` binds
	# as `([ a ] || [ b ]) && return 0` in bash, which is not what it reads like and
	# would open the window whenever the start hour was empty.
	[ -z "$start" ] && return 0
	[ "$start" = "-1" ] && return 0
	[ -z "$hours" ] && return 0
	[ "$hours" = "0" ] && return 0

	local nowHour=$(date +%-H)
	local endHour=$(( (start + hours) % 24 ))

	if [ "$start" -lt "$endHour" ]; then
		if [ "$nowHour" -ge "$start" ] && [ "$nowHour" -lt "$endHour" ]; then return 0; fi
	else
		# Window wraps past midnight, e.g. start 23 for 4 hours -> 23,0,1,2.
		if [ "$nowHour" -ge "$start" ]; then return 0; fi
		if [ "$nowHour" -lt "$endHour" ]; then return 0; fi
	fi
	return 1
}

# Record which PART of the update is running.
#
# update_state only ever said "updating", which meant the UI showed that for several minutes
# while the thing actually happening was a backup -- indistinguishable from a stuck job. The
# phase is what the operator is really asking about when they look.
setPhase() {
	local worldName="$1" phase="$2"
	SQL "UPDATE worlds SET update_phase='$phase', update_phase_at=NOW() WHERE name='$worldName';"
	phvlog NOTICE "Auto-update '$worldName': phase=$phase"
}

# Is the world's server process actually alive?
#
# Asked of the PROCESS TABLE, not of supervisor and not of worlds.mode. This runs as the
# phvalheim user, which cannot talk to supervisor at all (see stopWorld below), and mode is
# what we are trying to verify rather than something to trust. Matched on the world's own
# game directory so two worlds cannot be confused for each other.
worldProcessRunning() {
	pgrep -f "worlds/$1/game/valheim_server.x86_64" > /dev/null 2>&1
}

# Stop the world and DO NOT RETURN until it is really down.
#
# This used to be a bare `supervisorctl stop ... > /dev/null 2>&1`, which cannot work: cron
# runs updateApplier as the phvalheim user, supervisord.conf is 0660 root:root and its socket
# is 0700 root:root, so supervisorctl exits 2 with "could not read config file" -- and 2>&1
# threw that away. The world was never stopped, and steamcmd went on to replace the game
# files underneath a live server. Observed on a real server: the process ran through the
# entire update and the UI still reported the world as left stopped.
#
# Routed through worlds.mode instead, which the ENGINE owns and the engine runs as root. That
# is the same path the admin UI's Stop button uses, and the same one this script already used
# for the mods phase, so there is one mechanism rather than two.
#
# Returns non-zero if the world is still running at the end. Every caller must treat that as
# fatal: touching game files under a running server is the thing this exists to prevent.
# IT WAITS FOR THE ENGINE'S MODE WRITE, NOT JUST FOR THE PROCESS TO DIE. This is the fix for
# the update Brian ran on 'Midgard' that reported "mod rebuild failed" five seconds in.
#
# The process dying is not the end of the engine's stop. Its stop branch loops
# `sleep 10; worldProcessRunning` and only writes mode='stopped' AFTER a sleep in which the
# process was already gone -- so the engine keeps running for up to ten seconds past the kill,
# and its LAST act is a write to the very column this script uses to hand work back to it.
#
# The old loop returned as soon as the process vanished, about five seconds in. The applier
# then ran the game update (ten seconds of steamcmd) and set mode='update' for the mods phase
# -- and the engine, finally waking from its sleep, wrote mode='stopped' straight over it. Both
# writes landed in the same second. The rebuild was never requested, waitForEngineUpdate saw a
# terminal mode on its first poll, and the world was left stopped and un-rebuilt.
#
# So the stop is not complete until the engine SAYS it is complete. Waiting on mode means the
# engine has left its stop branch, and nothing of its is still holding the pen.
stopWorldAndWait() {
	local worldName="$1" waited=0 limit=180 mode=""

	# Still check the process first: a world that was never running needs no stop, and the
	# engine will not write a mode for a command it was never given.
	if ! worldProcessRunning "$worldName"; then
		return 0
	fi

	SQL "UPDATE worlds SET mode='stop' WHERE name='$worldName';"

	while [ "$waited" -lt "$limit" ]; do
		sleep 5
		waited=$((waited + 5))
		mode=$(SQL "SELECT mode FROM worlds WHERE name='$worldName';")
		# BOTH conditions. The process table alone returns too early (the bug above); the mode
		# alone would accept a 'stopped' the engine wrote for some earlier command.
		if [ "$mode" = "stopped" ] && ! worldProcessRunning "$worldName"; then
			return 0
		fi
	done

	phvlog ERROR "Auto-update: '$worldName' did not stop within ${limit}s (mode=${mode:-unknown}, process $(worldProcessRunning "$worldName" && echo running || echo gone))"
	return 1
}

# Ask the engine to start the world again. Fire and forget: the engine's start path has its
# own readiness handling, and blocking here would hold the applier lock for no benefit.
startWorld() {
	SQL "UPDATE worlds SET mode='start' WHERE name='$1';"
}

# Wait for the engine to finish the mod rebuild it was handed via mode='update'.
#
# That handoff is asynchronous: setting the mode returns instantly and the engine picks the
# world up on its next tick. Without waiting, applyUpdate announced "Auto-update complete,
# mods rebuilt" while the rebuild had not started -- observed on a real server, where the
# world reported Updated and idle at 04:06:51 and the engine was still downloading mods at
# 04:07:11.
#
# The engine drives mode 'update' -> 'updating' -> 'stopped', so waiting while it is either
# of the first two is safe against the tick it has not seen yet. It marks a rebuild that
# failed with status='failed', which is the only way to tell a finished-badly world from a
# finished-well one.
waitForEngineUpdate() {
	local worldName="$1" waited=0 limit=900 mode="" sawRebuild=0

	# IT MUST SEE THE REBUILD START BEFORE IT WILL BELIEVE IT FINISHED.
	#
	# The old loop broke on the first mode that was not update/updating -- which includes the
	# mode the world was ALREADY in before the handoff. On Midgard that was 'stopped' (written
	# over our mode='update' by the engine's stop branch, see stopWorldAndWait), so this exited
	# on its first poll and the caller reported a failed rebuild five seconds into a job that
	# takes minutes. "Finished" and "never started" were the same observation.
	#
	# Now a terminal mode only counts once 'update' or 'updating' has actually been seen.
	while [ "$waited" -lt "$limit" ]; do
		mode=$(SQL "SELECT mode FROM worlds WHERE name='$worldName';")
		case "$mode" in
			update|updating) sawRebuild=1 ;;
			*) [ "$sawRebuild" = "1" ] && break ;;
		esac
		sleep 5
		waited=$((waited + 5))
	done

	if [ "$sawRebuild" != "1" ]; then
		phvlog ERROR "Auto-update: the mod rebuild for '$worldName' never started -- its mode was '$mode' for the whole ${waited}s wait, so something else overwrote the update request"
		return 1
	fi

	if [ "$waited" -ge "$limit" ]; then
		phvlog ERROR "Auto-update: mod rebuild for '$worldName' did not finish within ${limit}s"
		return 1
	fi

	if [ "$(SQL "SELECT IFNULL(status,'') FROM worlds WHERE name='$worldName';")" = "failed" ]; then
		phvlog ERROR "Auto-update: mod rebuild failed for '$worldName'"
		return 1
	fi

	return 0
}

# Clear the verdict fields THIS run is about to be judged on.
#
# worlds.status is persistent and NOTHING in the engine, 0-functions.sh or this script ever
# resets it away from 'failed' -- grep every writer and they all only ever set it. So a world
# that failed a rebuild once reported "mod rebuild failed" on every later auto-update forever,
# including ones that worked, because waitForEngineUpdate reads that same field afterwards.
#
# Midgard had been carrying status='failed' since an earlier incident -- confirmed by reading
# it eight minutes BEFORE the update that then "failed". Clearing here is what makes the check
# at the end a measurement of this run instead of a memory of the worst previous one.
# It must NOT write update_state. See the ordering note in applyUpdate: setting it to
# 'running' here is a value no reader knows, and it cost the Updates tab its live status for a
# release. The caller declares 'updating' immediately after this returns.
clearPriorVerdict() {
	local worldName="$1"
	SQL "UPDATE worlds SET status='', update_last_result=NULL \
		WHERE name='$worldName';"
}

applyUpdate() {
	local worldName="$1" scope="$2" backupFirst="$3"

	phvlog NOTICE "Auto-update starting for '$worldName' (scope=$scope, backup=$backupFirst)"

	# CLEAR FIRST, THEN DECLARE. The order matters and getting it wrong broke the Updates tab
	# for a whole release: clearPriorVerdict used to run on the line AFTER the
	# update_state='updating' write, and it set update_state='running' -- a value no reader
	# anywhere knows. The admin UI's poll keeps going only while
	# `update_check_state === 'checking' || update_state === 'updating'`, so it stopped on the
	# first tick and the tab fell through to the idle rendering: an update in progress reported
	# as up to date, with no live phase. It also disarmed reconcileStrandedUpdateState, which
	# finds interrupted updates by looking for exactly 'updating'.
	#
	# So the clear happens before the declaration, and it does NOT touch update_state. That
	# column is this run's LIVE signal; the stale-verdict fields are status and
	# update_last_result, and those are all it has any business resetting.
	clearPriorVerdict "$worldName"
	SQL "UPDATE worlds SET update_state='updating', update_last_result=NULL WHERE name='$worldName';"

	if [ "$backupFirst" = "1" ]; then
		setPhase "$worldName" "backup"
		phvlog NOTICE "Auto-update: backing up '$worldName' first"
		# worldBackup sets worlds.mode='backup' itself and restores the previous mode when
		# it finishes, which is what drives the Backup pill on the world row.
		/opt/stateless/engine/tools/worldBackup "$worldName" manual
		backupStatus=$?
		if [ "$backupStatus" -ne 0 ]; then
			# A backup that did not happen stops the whole thing. The point of taking one
			# is to have a way back; updating anyway would throw that away precisely when
			# it is most likely to be needed.
			#
			# 75 is worldBackup declining because another backup holds the global lock. It
			# used to exit 0 for that, so a skipped backup passed this check and the update
			# ran with no way back. Separated out because the two need different words: one
			# is broken, the other is just busy and will be fine on the next sweep.
			if [ "$backupStatus" -eq 75 ]; then
				phvlog NOTICE "Auto-update: another backup is running, so '$worldName' was not backed up -- deferring"
				SQL "UPDATE worlds SET update_state='pending', update_phase=NULL, \
					update_last_result='Deferred: another backup was running, so this world could not be backed up first. Nothing was changed.' \
					WHERE name='$worldName';"
			else
				phvlog ERROR "Auto-update: backup failed for '$worldName' -- not updating"
				SQL "UPDATE worlds SET update_state='failed', update_phase=NULL, \
					update_last_result='Backup failed before update; nothing was changed.' \
					WHERE name='$worldName';"
			fi
			return 1
		fi
	fi

	setPhase "$worldName" "stopping"
	if ! stopWorldAndWait "$worldName"; then
		# Abort with nothing touched. A world that will not stop is the one case where
		# carrying on does real damage -- steamcmd would rewrite the game tree under a
		# live server and players already connected to it.
		phvlog ERROR "Auto-update: '$worldName' would not stop -- nothing was updated"
		SQL "UPDATE worlds SET update_state='failed', update_phase=NULL, \
			update_last_result='The world could not be stopped, so nothing was updated. It is still running.' \
			WHERE name='$worldName';"
		return 1
	fi

	local result=""

	if [ "$scope" = "game" ] || [ "$scope" = "both" ]; then
		setPhase "$worldName" "game"
		InstallAndUpdateValheim "$worldName"
		if [ $? -ne 0 ]; then
			phvlog ERROR "Auto-update: game update failed for '$worldName'"
			# Say what is true of the world, not what is convenient. It IS stopped here --
			# stopWorldAndWait confirmed that against the process table before anything was
			# touched -- so the operator needs to know it will stay down until they act.
			SQL "UPDATE worlds SET update_state='failed', update_phase=NULL, \
				update_last_result='Valheim server update failed. The world was left stopped.' \
				WHERE name='$worldName';"
			return 1
		fi
		result="game updated"
	fi

	if [ "$scope" = "mods" ] || [ "$scope" = "both" ]; then
		setPhase "$worldName" "mods"
		# Hand the world to the engine's own update path rather than reimplementing mod
		# installation here. mode='update' rebuilds BepInEx, the mod set and the client
		# payload, and it already knows how to refuse to publish a modded world whose
		# mods failed to install.
		SQL "UPDATE worlds SET mode='update' WHERE name='$worldName';"
		if ! waitForEngineUpdate "$worldName"; then
			SQL "UPDATE worlds SET update_state='failed', update_phase=NULL, \
				update_last_result='The mod rebuild did not complete. The world was left stopped.' \
				WHERE name='$worldName';"
			return 1
		fi
		[ -n "$result" ] && result="$result, mods rebuilt" || result="mods rebuilt"
	fi

	# Start the world again, for EVERY scope.
	#
	# This used to sit in an `else` against the mods branch, on the assumption that the
	# engine's update path restarts what it updated. It does not: that path ends with
	# "finally, set the world to stopped state" and leaves mode='stopped' on purpose,
	# because it is also what a mod-list edit from the admin UI goes through. So any
	# auto-update whose scope included mods -- which is the default, 'both' -- stopped the
	# world and never brought it back, while reporting "Updated ... mods rebuilt".
	#
	# Seen on a real server: VikingOutlaws went down at 04:06 and was still down at 04:13
	# with update_state='idle' and a successful-looking result string.
	setPhase "$worldName" "starting"
	startWorld "$worldName"

	# $(date), not backticks: this SQL is inside DOUBLE quotes, so a backtick would be
	# command substitution in a string that already contains SQL quoting -- one of the
	# easier ways to write a statement that runs fine until a value contains a quote.
	local stamp=$(date "+%Y-%m-%d %H:%M")

	# update_available_* is cleared optimistically; the next updateChecker run is what
	# actually re-establishes it. If this update did not take, the flag comes straight
	# back rather than staying wrongly clear.
	SQL "UPDATE worlds SET update_state='idle', update_pending_since=NULL, \
		update_phase=NULL, update_phase_at=NULL, update_check_error=NULL, \
		update_available_game=0, update_available_mods=0, \
		update_last_result='Updated $stamp: $result.' \
		WHERE name='$worldName';"

	phvlog NOTICE "Auto-update complete for '$worldName': $result"
	return 0
}


# --- manual path: the admin UI's "Update now" ----------------------------------------
if [ -n "$targetWorld" ] && [ "$forceNow" = "now" ]; then
	scope=$(getEffective "$targetWorld" autoupdate_scope autoUpdateScope)
	[ -z "$scope" ] && scope="both"
	backupFirst=$(getEffective "$targetWorld" autoupdate_backup_first autoUpdateBackupFirst)
	[ -z "$backupFirst" ] && backupFirst="1"

	applyUpdate "$targetWorld" "$scope" "$backupFirst"
	exit $?
fi


# --- scheduled sweep ------------------------------------------------------------------
#
# Only worlds that are RUNNING, have something to update, and are not already mid-update.
# Offline worlds are deliberately untouched: they pick updates up when they next start.
candidates=$(SQL "SELECT name FROM worlds WHERE mode='running' \
	AND (update_available_game=1 OR update_available_mods>0) \
	AND update_state IN ('idle','pending');")

[ -z "$candidates" ] && exit 0

for worldName in $candidates; do
	export PHV_WORLD="$worldName"   # events below are filed against this world (2.56)
	mode=$(getEffective "$worldName" autoupdate_mode autoUpdateMode)
	[ "$mode" = "1" ] || continue

	idleMinutes=$(getEffective "$worldName" autoupdate_idle_minutes autoUpdateIdleMinutes)
	[ -z "$idleMinutes" ] && idleMinutes=30
	maxWait=$(getEffective "$worldName" autoupdate_max_wait_hours autoUpdateMaxWaitHours)
	[ -z "$maxWait" ] && maxWait=24
	onTimeout=$(getEffective "$worldName" autoupdate_on_timeout autoUpdateOnTimeout)
	[ -z "$onTimeout" ] && onTimeout="wait"
	scope=$(getEffective "$worldName" autoupdate_scope autoUpdateScope)
	[ -z "$scope" ] && scope="both"
	backupFirst=$(getEffective "$worldName" autoupdate_backup_first autoUpdateBackupFirst)
	[ -z "$backupFirst" ] && backupFirst="1"
	windowStart=$(getEffective "$worldName" autoupdate_window_start autoUpdateWindowStart)
	windowHours=$(getEffective "$worldName" autoupdate_window_hours autoUpdateWindowHours)

	SQL "UPDATE worlds SET update_state='pending' \
		WHERE name='$worldName' AND update_state='idle';"

	# Has the world been waiting longer than the operator is willing to wait?
	expired=$(SQL "SELECT COUNT(*) FROM worlds WHERE name='$worldName' \
		AND update_pending_since IS NOT NULL \
		AND update_pending_since < DATE_SUB(NOW(), INTERVAL $maxWait HOUR);")

	if [ "$expired" = "1" ] && [ "$onTimeout" = "force" ]; then
		phvlog NOTICE "Auto-update: '$worldName' passed its ${maxWait}h wait; updating regardless of players"
		applyUpdate "$worldName" "$scope" "$backupFirst"
		continue
	fi

	# Say WHY a world is being held back. "Pending" on its own reads like a stuck job, and
	# since the idle rule got stricter above, the most common reason to wait is now "someone
	# is on it" -- which is the one thing the operator would want to see named. Overwriting
	# update_last_result is what that column is for; applyUpdate() replaces it with the
	# outcome the moment this world does go.
	if ! isIdle "$worldName" "$idleMinutes"; then
		heldCount=$(SQL "SELECT IFNULL(player_count,0) FROM worlds WHERE name='$worldName';")
		if [ "${heldCount:-0}" != "0" ]; then
			SQL "UPDATE worlds SET update_last_result='Waiting: $heldCount player(s) last seen on this world. The update will apply once it is empty.' \
				WHERE name='$worldName';"
		else
			SQL "UPDATE worlds SET update_last_result='Waiting: this world has not reported a current player count, so it is not safe to restart it yet.' \
				WHERE name='$worldName';"
		fi
		continue
	fi

	inWindow "$windowStart" "$windowHours" || continue

	applyUpdate "$worldName" "$scope" "$backupFirst"
done
