#!/bin/bash
PHV_LOG_SOURCE=playerMonitor   # names this tool in the event log (2.56)
source /opt/stateless/engine/includes/phvalheim-static.conf

# Player counts and crossplay join codes, per running world, every two minutes (cron).
#
# THE COUNT IS REAL (2.58). The PhValheim Companion on each modded world's dedicated server
# writes its own player roster -- ZNet.GetPlayerList(), the list the server broadcasts to every
# peer -- to <world>/game/BepInEx/data/PhValheim.Companion/player_stats.json every 5s, and this
# script copies player_count out of it while the file is fresh. Nothing is inferred any more.
#
# Until 2.58 the count was parsed out of the world log: PlayFab's "now N player(s)" line on
# crossplay worlds, the ten-minute "Connections N" heartbeat plus socket events elsewhere. It
# was verified against real players once (2026-09-15) and wrong often enough afterwards --
# a count from before a restart survived the restart; "Connections N" reads 0 on a crossplay
# world with a player on it -- that the maintainer had it switched off, then replaced. The
# history is in docs/RELEASE-2.47-DESIGN.md; the code is gone from here on purpose.
#
# A VANILLA world runs no BepInEx, so it has no Companion and no count: it reads as unknown,
# which every reader already handles (no pill count, no public count, "not yet observed").
#
# The join code (below) is still read from the log: Valheim prints it there and nowhere else.

logDir="/opt/stateful/logs"

# Turn a Valheim log timestamp (MM/DD/YYYY HH:MM:SS) into a MySQL DATETIME.
logTimeToSql() {
	local stamp="$1"
	[ -z "$stamp" ] && return 1
	date -d "$stamp" "+%Y-%m-%d %H:%M:%S" 2>/dev/null
}

# Pull the timestamp out of a log line. Most lines start with it, but some are wrapped by
# BepInEx ("Console: [Info : Unity Log] 01/26/2025 15:06:39: ..."), so match it anywhere.
lineStamp() {
	echo "$1" | grep -oE '[0-9]{2}/[0-9]{2}/[0-9]{4} [0-9]{2}:[0-9]{2}:[0-9]{2}' | head -1
}

worldRows=$(SQL "SELECT name, IFNULL(crossplay,0) FROM worlds WHERE mode='running';")

# How old the Companion's player_stats.json may be and still count as current. It is written
# every 5s; 60s absorbs a stalled tick without letting a dead server's last file stand for long.
PHV_PLAYER_STATS_MAX_AGE="${PHV_PLAYER_STATS_MAX_AGE:-60}"

# A world that is not running has no players, and its last observation is not information: a
# count left on the row showed up on the dashboard under an "Updating" pill (2026-10-23).
SQL "UPDATE worlds SET player_count=0, player_count_at=NULL, player_count_source='none' WHERE mode<>'running' AND player_count_at IS NOT NULL;"

[ -z "$worldRows" ] && exit 0

# Every reader below works on a world's HISTORY -- the rotated generation followed by the live
# log -- never on the live log alone.
#
# logRotater.sh is `cp` + truncate and keeps exactly one generation, so every rotation moves
# whatever a world last said into `<log>.1` and leaves the live log empty of it. Everything
# this script reads is an EVENT that Valheim does not repeat: a crossplay count is printed on
# a join or a leave and at no other time, the join code at registration and on joins/leaves.
# Reading the live log alone, a busy modded world (which passes the 1 MB threshold within
# minutes) lost both at the first rotation:
#
#   - the join code: the dashboard said "waiting for its join code" for 35 hours on a world
#     that was up and joinable the whole time (production, 2026-10-18).
#   - the player count: the count line vanished, the no-count branch wrote player_count=0 and
#     left player_count_at on the PREVIOUS observation -- so a world with players on it read
#     as a fresh, confident zero, which is the one thing updateApplier's isIdle() accepts as
#     permission to restart a world.
#
# Two generations make a single rotation harmless. A second rotation with no new event in
# between still loses the line; for the join code that case is covered by what is remembered
# in the database (below), and for the count by reporting it as unknown rather than zero.
histFile=$(mktemp)
trap 'rm -f "$histFile"' EXIT

# The player count for one running world, from the Companion's file. Called FIRST in the loop
# below, before the log is even looked for: the count does not come from the log any more, and
# a world whose log is missing must still get its count (and lose a stale one).
readCompanionCount() {
	local worldName="$1" statsFile age count sqlStamp

	# --- the player count: REAL, from the Companion on the dedicated server (2.58) -----------
	#
	# Until 2.58 the count was inferred from the log (PlayFab "now N player(s)" on crossplay
	# worlds, the ten-minute "Connections N" heartbeat plus socket events elsewhere) and it was
	# wrong often enough to be switched off: a count from before a restart survived the restart,
	# a crossplay world read 0 with a player on it. The maintainer's verdict: real data or
	# nothing. The PhValheim Companion, which ships in the image and is installed on every
	# modded world, now writes the server's own roster (ZNet.GetPlayerList) every 5s to
	#   <world>/game/BepInEx/data/PhValheim.Companion/player_stats.json
	# and this reads it. The file is current only while its mtime is fresh: a server that is
	# gone leaves a stale file, and stale means UNKNOWN (player_count_at NULL) -- never a
	# confident zero, which is the one value updateApplier's isIdle() accepts as permission to
	# restart a world. A vanilla world runs no BepInEx and so has no Companion: unknown, honestly.
	statsFile="/opt/stateful/games/valheim/worlds/$worldName/game/BepInEx/data/PhValheim.Companion/player_stats.json"
	if [ ! -f "$statsFile" ]; then
		SQL "UPDATE worlds SET player_count=0, player_count_at=NULL, player_count_source='none' WHERE name='$worldName';"
		return
	fi
	age=$(( $(date +%s) - $(stat -c %Y "$statsFile" 2>/dev/null || echo 0) ))
	count=$(jq -r '.player_count // empty' "$statsFile" 2>/dev/null)
	if [ "$age" -gt "$PHV_PLAYER_STATS_MAX_AGE" ] || ! [[ "$count" =~ ^[0-9]+$ ]]; then
		SQL "UPDATE worlds SET player_count=0, player_count_at=NULL, player_count_source='none' WHERE name='$worldName';"
		return
	fi
	sqlStamp=$(date -d "@$(stat -c %Y "$statsFile")" "+%Y-%m-%d %H:%M:%S")
	SQL "UPDATE worlds SET player_count=$count, player_count_at='$sqlStamp', player_count_source='companion' WHERE name='$worldName';"
}

while IFS=$'\t' read -r worldName isCrossplay; do
	[ -z "$worldName" ] && continue

	readCompanionCount "$worldName"

	logFile="$logDir/valheimworld_${worldName}.log"
	[ -f "$logFile" ] || continue

	{ [ -f "$logFile.1" ] && cat "$logFile.1"; cat "$logFile"; } > "$histFile" 2>/dev/null

	# --- the crossplay join code, remembered past rotation --------------------------------
	#
	# The SAME rule as getWorldJoinCode() in db_gets.php, which is the reader; this is the
	# writer. dev_tools/test-joincode-survives-rotation.php drives both with the same fixtures
	# so the two cannot drift. Over the history:
	#
	#   the session = everything after the LAST "Starting to load scene: start.unity", which
	#                 Valheim logs once per launch -- the only session boundary in the log.
	#                 If no start is visible, the whole history is one session.
	#   the code    = the LAST "join code N" in that session. The last mention, not the
	#                 registration line: Valheim re-reports a sticky lobby code on registration
	#                 and replaces it a second later (see the comment on getWorldJoinCode()).
	#
	# Then:
	#   a code              -> remember it.
	#   no code, a start    -> a session whose code is not issued yet. FORGET the remembered
	#                          one: it belongs to an earlier session, and a dead code fails
	#                          silently -- worse than showing none.
	#   no code, no start   -> the session began before both generations and nobody has joined
	#                          since. Leave the remembered code alone: this is the case the
	#                          column exists for.
	#
	# Why the last case cannot keep a DEAD code: forgetting only needs this script to see the
	# new session's start line once. It runs every 2 minutes over both generations, so the line
	# would have to pass through TWO rotations between runs, and logRotater runs every 15.
	#
	# Keyed on what the log shows, not on "cleared when the engine starts the world": the
	# engine is not the only thing that starts one. Supervisor's autorestart relaunches a
	# crashed world without the engine knowing, and a clear-on-start rule would serve the dead
	# code straight through it.
	#
	# Not gated on the crossplay column, which only takes effect at the next restart. A Steam
	# session logs no code, lands in "no code, a start", and is cleared.
	startNo=$(grep -an "Starting to load scene: start.unity" "$histFile" | tail -1 | cut -d: -f1)
	joinCode=$(tail -n "+${startNo:-1}" "$histFile" | grep -aoE 'join code [0-9]{4,10}' | tail -1 | grep -oE '[0-9]+$')

	if [ -n "$joinCode" ]; then
		SQL "UPDATE worlds SET join_code='$joinCode' WHERE name='$worldName';"
	elif [ -n "$startNo" ]; then
		SQL "UPDATE worlds SET join_code=NULL WHERE name='$worldName';"
	fi

done <<< "$worldRows"
