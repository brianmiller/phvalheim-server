#!/bin/bash
PHV_LOG_SOURCE=restore   # names this tool in the event log (2.56)
source /opt/stateless/engine/includes/phvalheim-static.conf

# World Restore - restores a world from a backup
#
# Usage: worldRestore <backupId>
#
# Outputs JSON progress lines to stdout for PHP to capture.
# Final line is the JSON result.

LOCK_FILE="/tmp/worldRestore.lock"
LOG="/opt/stateful/logs/worldBackups.log"

# Neither of these removes the lock file any more -- see the flock block below. The old
# jsonError() `rm -f` was reached on the "another restore is already in progress" path,
# where it deleted the RUNNING restore's lock file and left the next caller free to start
# a second concurrent restore. flock releases on process exit; nothing needs unlinking.
function jsonError() {
	echo "{\"success\":false,\"error\":\"$1\"}"
	exit 1
}

function jsonSuccess() {
	echo "{\"success\":true,\"message\":\"$1\",\"safetyBackupId\":\"${2:-}\"}"
	exit 0
}

function progress() {
	echo "{\"progress\":\"$1\"}"
	phvlog INFO " $1" >> "$LOG"
}

# prevent concurrent restores
#
# flock on a READ-ONLY descriptor, not a pidfile. (2.52) `echo $$ >` needs write permission
# on a file in sticky /tmp, so the first uid to run owns it and any other uid is locked out
# permanently -- the bug that killed the mod-catalogue sync in 2.47-2.51. Only the admin UI
# (phvalheim) invokes this today, so the uid split is defensive here; the pidfile's own
# failure modes were not. flock releases when the holder dies, so a killed restore cannot
# wedge every later one, and there is no stale-pid guess to get wrong.
[ -e "$LOCK_FILE" ] || (umask 0022; : > "$LOCK_FILE") 2>/dev/null
exec 9<"$LOCK_FILE"
flock -n 9 || jsonError "Another restore is already in progress"

backupId="$1"

if [ -z "$backupId" ]; then
	jsonError "Backup ID required"
fi

# validate backup exists in DB
backupData=$(SQL "SELECT CONCAT(world_name, '|', file_path, '|', file_size, '|', compressed, '|', compression_type, '|', IFNULL(created_at,'')) FROM backups WHERE id=$backupId;")
if [ -z "$backupData" ]; then
	jsonError "Backup ID $backupId not found in database"
fi

worldName=$(echo "$backupData" | cut -d'|' -f1)
backupFilePath=$(echo "$backupData" | cut -d'|' -f2)
backupFileSize=$(echo "$backupData" | cut -d'|' -f3)
backupCompressed=$(echo "$backupData" | cut -d'|' -f4)
backupCompressionType=$(echo "$backupData" | cut -d'|' -f5)
backupCreatedAt=$(echo "$backupData" | cut -d'|' -f6)

# check if world is in a transitional state — do not restore during start/stop/update/create/delete/backup
worldMode=$(SQL "SELECT mode FROM worlds WHERE name='$worldName';")
case "$worldMode" in
	start|starting|stop|stopping|create|creating|update|updating|delete|deleting|backup)
		jsonError "World '$worldName' is currently ${worldMode}. Cannot restore while the world is in a transitional state. Please wait and try again."
		;;
esac

# validate backup file exists on disk
if [ ! -f "$backupFilePath" ]; then
	jsonError "Backup file not found: $backupFilePath"
fi

progress "Backup file: $(basename "$backupFilePath") ($(echo "$backupFileSize" | awk '{printf "%.1f MB", $1/1048576}'))"

worldDir="$worldsDirectoryRoot/$worldName"

phvlog NOTICE "Starting restore of '$worldName' from backup id=$backupId" >> "$LOG"

# step 1: create world directory if missing
if [ ! -d "$worldDir" ]; then
	progress "Creating world directory (was missing)..."
	mkdir -p "$worldDir"
	chown phvalheim:phvalheim "$worldDir"
fi

# step 2: stop the world if running
#
# THIS IS WHAT OVERWROTE A RESTORED WORLD (reported 2026-10-16: a 10-03 backup restored
# cleanly and the operator still found tonight's damage in the game).
#
# It used to ask `supervisorctl status`, which this script CANNOT run. worldRestore is
# launched from adminAPI.php, so it runs as the `phvalheim` user, and supervisord.conf is
# 0660 root:root with a 0700 root:root socket -- the call dies with "could not read config
# file" and a NON-ZERO exit. `[ $? -eq 0 ]` then read that permission failure as "the world
# is not running" and skipped the stop entirely. The restore extracted the backup UNDERNEATH
# a live Valheim, and the `mode='update'` at the end made the ENGINE -- which is root, so its
# supervisorctl works -- stop the world properly. On a clean shutdown Valheim saves, so it
# wrote its in-memory world, hours newer than the backup, over the files just restored.
# Every step reported success. The proof it never stopped anything: "Stopping world process"
# does not appear once in worldBackups.log for that restore.
#
# So stop through `worlds.mode`, which the engine performs as root, and confirm with the
# PROCESS TABLE, which any uid can read. An un-stoppable world is FATAL from here on:
# extracting over a running world is exactly how the data was lost, and a restore that
# refuses is recoverable while one that half-works is not.
#
# [v]alheim_server, not valheim_server: pgrep -f matches its own invoking command line.
worldRunning() {
	pgrep -f "worlds/$1/game/[v]alheim_server.x86_64" > /dev/null 2>&1
}

if worldRunning "$worldName"; then
	progress "Stopping world process..."
	SQL "UPDATE worlds SET mode='stop' WHERE name='$worldName';"

	# The engine's loop ticks every 2s; a world with players saves on the way down.
	stopWaited=0
	while [ "$stopWaited" -lt 120 ]; do
		worldRunning "$worldName" || break
		sleep 2
		stopWaited=$((stopWaited + 2))
		[ $((stopWaited % 20)) -eq 0 ] && progress "Still waiting for '$worldName' to stop (${stopWaited}s)..."
	done

	if worldRunning "$worldName"; then
		phvlog ERROR "Restore of '$worldName' ABORTED: the world would not stop after ${stopWaited}s" >> "$LOG"
		jsonError "World '$worldName' did not stop after ${stopWaited}s, so nothing has been restored. Valheim saves when it shuts down and would have written over the restored files. Stop the world from the dashboard and try again."
	fi

	# Settle: the save file is written during shutdown, and the process can be gone a moment
	# before the last write lands.
	sleep 3
	progress "World stopped."
else
	progress "World is not running."
fi

# step 3: create pre-restore safety backup (only if directory has content and enough disk space)
safetyBackupId=""
dirContentCount=$(find "$worldDir" -mindepth 1 -maxdepth 1 2>/dev/null | wc -l)
if [ "$dirContentCount" -gt 0 ]; then
	# check disk space for safety backup
	worldDirSize=$(du -sb "$worldDir" --exclude="${worldName}.zip" 2>/dev/null | cut -f1)
	worldDirSize=${worldDirSize:-0}
	availBytes=$(df --output=avail -B1 "$backupDir" 2>/dev/null | tail -1 | tr -d ' ')
	availBytes=${availBytes:-0}
	neededBytes=$((worldDirSize + worldDirSize / 10))  # world size + 10% headroom

	if [ "$availBytes" -lt "$neededBytes" ]; then
		availMB=$(echo "$availBytes" | awk '{printf "%.1f", $1/1048576}')
		neededMB=$(echo "$neededBytes" | awk '{printf "%.1f", $1/1048576}')
		progress "WARNING: Not enough disk space for safety backup (need ~${neededMB} MB, only ${availMB} MB free). Skipping pre-restore backup."
	else
		progress "Creating pre-restore safety backup of current state..."
		safetyTimestamp=$(date +%Y-%m-%dT%H:%M:%S%z)
		safetyFile="$backupDir/valheimworld_${worldName}-${safetyTimestamp}-prerestore.tar"

		cd "$worldDir"
		#client/ excluded for the same reason as the payload zip and for the same reason
		#worldBackup excludes it: the client staging tree (2.53+) is derived, and the world
		#update that follows any restore rebuilds it from scratch.
		/usr/bin/tar cf "$safetyFile" --exclude="./${worldName}.zip" --exclude="./client" . >> "$LOG" 2>&1

		if [ -f "$safetyFile" ]; then
			safetySize=$(stat --format=%s "$safetyFile" 2>/dev/null || echo 0)
			SQL "INSERT INTO backups (world_name, created_at, type, file_path, file_size, compressed, compression_type, metadata)
				VALUES ('$worldName', NOW(), 'manual', '$safetyFile', $safetySize, 0, 'none', '{\"pre_restore\":true,\"restored_from_id\":$backupId}');"
			safetyBackupId=$(SQL "SELECT id FROM backups WHERE file_path='$safetyFile' LIMIT 1;")
			progress "Safety backup created ($(echo "$safetySize" | awk '{printf "%.1f MB", $1/1048576}'))"
		fi
	fi
else
	progress "World directory is empty, skipping safety backup."
fi

# step 4: clear current world directory
progress "Clearing current world directory..."
find "$worldDir" -mindepth 1 -delete

# step 5: detect backup format and extract
# Old backups (pre-2.38) contain Unity save files (worlds_local/, adminlist.txt)
# New backups (2.38+) contain the full world directory (game/, custom_configs/, etc.)
#
# The distinction is WHERE worlds_local/ sits, not whether it is present -- both formats
# contain it. Pre-2.38 worldBackup ran from
#   $worldDir/game/.config/unity3d/IronGate/Valheim/
# so the archive holds ./worlds_local/ at its ROOT. 2.38+ worldBackup runs from $worldDir,
# so the very same worlds_local/ appears far below, at
#   ./game/.config/unity3d/IronGate/Valheim/worlds_local/
#
# An UNANCHORED match therefore matched every modern backup too, so every restore took the
# legacy branch and unpacked the whole world tree into
# $worldDir/game/.config/unity3d/IronGate/Valheim/ -- burying the real save one entire world
# tree deep and leaving the server's -savedir worlds_local empty. Valheim then generated a
# brand-new world, which looked exactly like the backup had restored a fresh seed. The
# "new format" branch below was unreachable. Anchor to the archive root. (issue #89)
isOldFormat=0

#Reads a tar listing on stdin. True only when the Unity save dir is at the archive ROOT.
function archiveListingIsLegacy() {
	grep -qE '^\./worlds_local/|^worlds_local/'
}
case "$backupFilePath" in
	*.tar.gz)
		tarListCmd="tar tzf"
		tarExtractCmd="tar xzf"
		;;
	*.tar.zst)
		tarListCmd="zstd -dq --stdout $backupFilePath | tar tf -"
		tarExtractCmd="zstd -dq --stdout $backupFilePath | tar xf -"
		;;
	*.tar)
		tarListCmd="tar tf"
		tarExtractCmd="tar xf"
		;;
	*)
		jsonError "Unknown backup format: $backupFilePath"
		;;
esac

# check if old format by looking for worlds_local/ AT THE ROOT of the archive
if [ "$tarListCmd" = "tar tf" ] || [ "$tarListCmd" = "tar tzf" ]; then
	$tarListCmd "$backupFilePath" 2>/dev/null | archiveListingIsLegacy && isOldFormat=1
else
	eval "$tarListCmd" 2>/dev/null | archiveListingIsLegacy && isOldFormat=1
fi

extractStart=$(date +%s%N)

if [ "$isOldFormat" = "1" ]; then
	# old format: extract to game/.config/unity3d/IronGate/Valheim/
	progress "Detected legacy backup format — extracting to Unity save path..."
	targetDir="$worldDir/game/.config/unity3d/IronGate/Valheim"
	mkdir -p "$targetDir"

	case "$backupFilePath" in
		*.tar.gz)  tar xzf "$backupFilePath" -C "$targetDir" ;;
		*.tar.zst) zstd -dq --stdout "$backupFilePath" | tar xf - -C "$targetDir" ;;
		*.tar)     tar xf "$backupFilePath" -C "$targetDir" ;;
	esac
else
	# new format: extract directly to world directory
	progress "Extracting full world backup..."

	case "$backupFilePath" in
		*.tar.gz)  tar xzf "$backupFilePath" -C "$worldDir" ;;
		*.tar.zst) zstd -dq --stdout "$backupFilePath" | tar xf - -C "$worldDir" ;;
		*.tar)     tar xf "$backupFilePath" -C "$worldDir" ;;
	esac
fi

if [ $? -ne 0 ]; then
	phvlog FAIL " Backup extraction failed!" >> "$LOG"
	jsonError "Backup extraction failed"
fi

# step 5b: undo the nesting left behind by a pre-2.48 restore (issue #89)
#
# Fixing the probe above stops NEW damage, but it cannot help a world that was already
# restored by 2.38-2.47: that world directory has the whole tree buried one level down,
# under game/.config/unity3d/IronGate/Valheim/. Automatic backups run every 30 minutes, so
# every backup taken since then contains the nesting too -- unpacking one correctly still
# leaves the save buried and the server's -savedir empty, and the world still boots as a
# fresh seed. The operator has no way out through the UI.
#
# The signature is the Unity save path appearing TWICE in a row: a real world directory
# holds worlds_local/, cache/ and the access lists under .../IronGate/Valheim, never another
# game/ tree. Each lift peels exactly one level, so the loop also recovers a world that was
# restored badly more than once (two bad restores nest it three deep); the bound keeps a
# surprise layout from spinning forever.
unityRel="game/.config/unity3d/IronGate/Valheim"
liftCount=0
while [ "$liftCount" -lt 5 ] && [ -d "$worldDir/$unityRel/$unityRel" ]; do
	liftCount=$((liftCount+1))
	progress "Repairing a world tree nested by a pre-2.48 restore (issue #89)..."

	liftTmp="${worldDir}.lift.$$"
	rm -rf "$liftTmp"
	# the buried directory IS the real world root -- move it clear, then swap it in
	if ! mv "$worldDir/$unityRel" "$liftTmp" 2>>"$LOG"; then
		progress "WARNING: could not lift the nested world tree; leaving it as extracted."
		rm -rf "$liftTmp"
		break
	fi
	find "$worldDir" -mindepth 1 -delete
	find "$liftTmp" -mindepth 1 -maxdepth 1 -exec mv -t "$worldDir" {} +
	rm -rf "$liftTmp"
done
if [ "$liftCount" -gt 0 ]; then
	phvlog NOTICE "Lifted a nested world tree for '$worldName' ($liftCount level(s), issue #89)" >> "$LOG"
	progress "Repaired nesting from a pre-2.48 restore ($liftCount level(s))."
fi

extractEnd=$(date +%s%N)
extractMs=$(( (extractEnd - extractStart) / 1000000 ))
extractSec=$(echo "$extractMs" | awk '{printf "%.1f", $1/1000}')
restoredFiles=$(find "$worldDir" -type f 2>/dev/null | wc -l)
restoredSize=$(du -sb "$worldDir" 2>/dev/null | cut -f1)
restoredSize=${restoredSize:-0}
progress "Extracted $restoredFiles files ($(echo "$restoredSize" | awk '{printf "%.1f MB", $1/1048576}')) in ${extractSec}s"

# step 6: fix ownership
progress "Setting file ownership on $restoredFiles files..."
chown -R phvalheim:phvalheim "$worldDir"

# step 7: set world mode to 'update' to trigger engine rebuild
progress "Triggering world rebuild (mode=update)..."
SQL "UPDATE worlds SET mode='update' WHERE name='$worldName';"

# step 8: the world stays stopped, and we say so
#
# This used to `supervisorctl start` and then report either "started successfully" or
# "queued (engine will start when ready)". As the phvalheim user the start silently failed,
# and NEITHER message was true: nothing was queued and nothing was going to start it. The
# engine's update branch ends on mode='stopped' on purpose -- see the comment at its head --
# so a restore cannot hand a start off to it either.
#
# An operator who is told "started successfully" and finds the world down assumes the restore
# failed. Say what actually happens instead, and let them press Start.
progress "Rebuild queued. '$worldName' stays STOPPED until it finishes -- then start it from the dashboard."

phvlog NOTICE "Restore complete for '$worldName' from backup id=$backupId (world left stopped, mode=update)" >> "$LOG"

jsonSuccess "World '$worldName' restored from backup #$backupId. It is rebuilding and will stay stopped -- start it from the dashboard once the rebuild finishes." "$safetyBackupId"
